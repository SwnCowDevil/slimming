# Copy to backend/.env and fill locally. Never commit real secrets.
SLIMMING_DATABASE_URL=sqlite:///./data/slimming.db
SLIMMING_ENVIRONMENT=development
SLIMMING_JWT_SECRET=replace-with-at-least-32-random-characters
SLIMMING_WECHAT_APP_ID=
SLIMMING_WECHAT_APP_SECRET=
SLIMMING_ENABLE_DEV_AUTH=false
SLIMMING_AI_PROVIDER=deepseek
SLIMMING_AI_BASE_URL=https://api.deepseek.com
SLIMMING_AI_MODEL=deepseek-v4-flash
SLIMMING_AI_API_KEY=
SLIMMING_AI_RECIPE_ENABLED=false
SLIMMING_AI_TIMEOUT_SECONDS=25
SLIMMING_AI_MAX_RETRIES=2
SLIMMING_AI_RECIPE_SESSION_TTL_HOURS=24
SLIMMING_AI_RECIPE_USER_LIMIT_PER_HOUR=20
SLIMMING_AI_RECIPE_IP_LIMIT_PER_HOUR=60
SLIMMING_MEDIA_ROOT=./data/media
SLIMMING_TKA_IMPORT_ROOT=./data/imports
SLIMMING_ADMIN_IMPORT_KEY=replace-with-a-separate-import-key
