slimming.sunks.cc {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8001
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
  log {
    output file /var/log/caddy/slimming-api.log
    format json
  }
}
