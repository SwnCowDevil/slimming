[Unit]
Description=Slimming FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=slimming
Group=slimming
WorkingDirectory=/opt/slimming/backend
EnvironmentFile=/etc/slimming/slimming-api.env
ExecStart=/opt/slimming/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/slimming/backend/data

[Install]
WantedBy=multi-user.target
