FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend /app
RUN pip install --no-cache-dir /app
RUN groupadd --gid 10001 slimming && useradd --uid 10001 --gid slimming --create-home --shell /usr/sbin/nologin slimming
RUN mkdir -p /app/data && chown -R slimming:slimming /app/data
USER slimming
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
