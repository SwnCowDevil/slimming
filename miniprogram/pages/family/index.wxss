.join-panel {
  padding: 26rpx;
  border-radius: 26rpx;
  background: #f0f7fc;
}

.join-title,
.join-copy {
  display: block;
}

.join-title {
  color: #556b79;
  font-size: 27rpx;
  font-weight: 500;
}

.join-copy {
  margin-top: 8rpx;
  color: #718591;
  font-size: 21rpx;
  line-height: 1.55;
}

.join-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 164rpx;
  gap: 14rpx;
  margin-top: 22rpx;
}

.join-form input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d9e7ef;
  border-radius: 20rpx;
  background: #fff;
  color: #586b76;
  font-size: 23rpx;
}

.join-form button {
  width: 164rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: #ffefd8;
  color: #815e3e;
  font-size: 23rpx;
  font-weight: 400;
}

.join-form button::after {
  border: 0;
}

.join-form button[disabled] {
  opacity: 0.6;
}
