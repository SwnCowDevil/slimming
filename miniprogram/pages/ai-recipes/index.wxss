.ai-page{display:flex;flex-direction:column;gap:22rpx}.ai-page .title{margin-bottom:0;font-size:38rpx}.form-card{padding:26rpx;border-radius:30rpx;background:#fff}.field-label{margin:24rpx 0 12rpx;color:#66766D;font-size:23rpx}.field-label:first-child{margin-top:0}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chip{padding:13rpx 20rpx;border-radius:999rpx;background:#F5F7F5;color:#7B8981;font-size:22rpx}.chip.active{background:#E8F5EF;color:#668D79}.text-field{height:76rpx;padding:0 22rpx;border-radius:22rpx;background:#F7F9F7;font-size:23rpx}.query{box-sizing:border-box;width:100%;height:150rpx;padding:20rpx 22rpx;border-radius:22rpx;background:#F7F9F7;font-size:23rpx}.recommend{height:80rpx;margin:28rpx 0 0;border:0;border-radius:24rpx;background:#FFEBCF;color:#A36F3D;font-size:25rpx}.recommend::after,.state button::after,.result-actions button::after{border:0}.state{padding:42rpx 24rpx;border-radius:26rpx;background:#F0F7FC;color:#778C99;text-align:center}.state.error{background:#FFF4E5}.state button{height:60rpx;margin:20rpx auto 0;border:0;border-radius:20rpx;background:#fff;color:#8B7964;font-size:22rpx}.fallback-note{padding:20rpx 24rpx;border-radius:22rpx;background:#FFF8E7;color:#9B8158;font-size:22rpx}.results{display:flex;flex-direction:column;gap:22rpx}.result-actions{display:flex;gap:16rpx}.result-actions button{flex:1;height:72rpx;margin:0;border:0;border-radius:22rpx;font-size:23rpx}.next{background:#EAF5EF;color:#648876}.adjust{background:#EEF6FC;color:#6F8798}.notice{padding:8rpx 16rpx;color:#9AA49E;font-size:20rpx;line-height:1.6;text-align:center}
