.detail{min-height:100vh;background:var(--color-page)}.hero{width:100%;height:500rpx}.body{margin-top:-36rpx;position:relative;background:var(--color-page);border-radius:38rpx 38rpx 0 0}.badges{display:flex;gap:10rpx}.badges text{padding:8rpx 14rpx;border-radius:999rpx;background:#EEF6FC;color:#708897;font-size:20rpx}.badges text+text{background:#FFF3DF;color:#A67845}.title-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.title-row .title{font-size:38rpx}.favorite{width:116rpx;height:62rpx;margin:0;border:0;border-radius:20rpx;background:#EAF5EF;color:#688A79;font-size:22rpx}.favorite::after{border:0}.meta{color:#C77B2F;font-size:23rpx;margin-bottom:16rpx}.section{font-size:29rpx;font-weight:500;margin-top:32rpx}.list-card{margin-top:14rpx;padding:8rpx 24rpx;border-radius:26rpx;background:#fff}.ingredient{display:flex;justify-content:space-between;padding:20rpx 0;color:#68776F;font-size:23rpx}.ingredient+.ingredient{border-top:1rpx solid #EEF1EF}.steps{display:flex;flex-direction:column;gap:18rpx;margin-top:16rpx}.step{display:flex;gap:18rpx;align-items:flex-start}.step>text{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:50%;background:#EEF6FC;color:#7890A0;font-size:20rpx}.step>view{flex:1;padding-top:4rpx;color:#5F6C65;font-size:24rpx;line-height:1.65}.safety{margin-top:28rpx;padding:24rpx;border-radius:24rpx;background:#FFF6E8;color:#8F7658;font-size:23rpx;line-height:1.6}.safety text{display:block;margin-bottom:6rpx;color:#A36F3D;font-weight:500}.allergen,.ai-notice{margin-top:16rpx;color:#949F99;font-size:20rpx;line-height:1.6}.button-primary{width:100%;margin-top:30rpx;background:#E8F3FA;color:#66869A}
