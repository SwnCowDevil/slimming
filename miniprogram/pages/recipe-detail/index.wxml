<view wx:if="{{recipe}}" class="detail">
  <image wx:if="{{recipe.image}}" class="hero" mode="aspectFill" src="{{recipe.image}}"/>
  <view class="body page">
    <view class="badges"><text>{{recipe.sourceLabel}}</text><text>{{recipe.nutritionLabel}}</text></view>
    <view class="title-row"><view class="title">{{recipe.title}}</view><button wx:if="{{recipe.id}}" class="favorite" disabled="{{favoriteBusy}}" bindtap="toggleFavorite">{{recipe.isFavorite?'已收藏':'收藏'}}</button></view>
    <view class="meta">{{recipe.minutes}} 分钟 · {{recipe.kcalLabel}}</view>
    <view class="subtitle">{{recipe.description}}</view>
    <view wx:if="{{recipe.ingredients.length}}" class="section">食材</view>
    <view wx:if="{{recipe.ingredients.length}}" class="list-card"><view wx:for="{{recipe.ingredients}}" wx:key="id" class="ingredient"><text>{{item.ingredient_name_zh || item.name_zh}}</text><text>{{item.grams}} 克</text></view></view>
    <view wx:if="{{recipe.steps.length}}" class="section">做法</view>
    <view wx:if="{{recipe.steps.length}}" class="steps"><view wx:for="{{recipe.steps}}" wx:key="index" class="step"><text>{{index+1}}</text><view>{{item}}</view></view></view>
    <view wx:if="{{recipe.safety_summary}}" class="safety"><text>孕期提示</text><view>{{recipe.safety_summary}}</view></view>
    <view wx:if="{{recipe.allergenLabel}}" class="allergen">过敏原：{{recipe.allergenLabel}}</view>
    <view wx:if="{{recipe.source_type==='ai'}}" class="ai-notice">AI 推荐仅供饮食安排参考，不替代医生建议。</view>
    <button class="button-primary" bindtap="record">{{buttonText}}</button>
  </view>
</view>
