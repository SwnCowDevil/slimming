.setup{display:flex;flex-direction:column;gap:22rpx}.setup .title{font-size:38rpx;font-weight:500}.form-card{padding:28rpx;background:#fff;border-radius:28rpx}.field-group{display:flex;flex-direction:column;gap:12rpx;margin-bottom:24rpx}.field-group:last-child{margin-bottom:0}.field-group>text{font-size:24rpx;color:var(--color-muted)}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.picker{display:flex;align-items:center;color:var(--color-text)}.block-title{font-size:28rpx;font-weight:500}.hint{margin:8rpx 0 24rpx;color:var(--color-caption);font-size:22rpx}.privacy-note{padding:24rpx 26rpx;border-radius:24rpx;background:var(--color-blue-soft);color:var(--color-muted);font-size:22rpx;line-height:1.7}.button-primary{width:100%;margin-top:4rpx}@media (max-width:360px){.field-grid{grid-template-columns:1fr}}
