.today{display:flex;flex-direction:column;gap:34rpx}.header{display:flex;justify-content:space-between;align-items:center}.greeting{font-size:38rpx;margin-bottom:0}.ai-button{width:72rpx;height:72rpx;padding:0;border-radius:50%;background:#FFF9EE;color:#C77B2F;font-size:22rpx;border:1rpx solid #F5E4C7}.ai-button::after{border:0}.actions{display:flex;flex-direction:column;gap:18rpx}.actions .button-primary,.actions .button-light{width:100%}.secondary{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.section-head{display:flex;justify-content:space-between;align-items:center;font-size:32rpx;font-weight:500}.section-head text:last-child{font-size:22rpx;font-weight:400;color:var(--color-caption)}
