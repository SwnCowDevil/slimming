<view class="page today"><view class="header"><view><view class="eyebrow">{{dateLabel}}</view><view class="title greeting">{{gestationLabel}}</view></view><button class="ai-button" bindtap="openAi">AI 回顾</button></view><view class="summary-card"><view><text class="summary-label">今天先照顾好自己</text><text class="summary-value">{{feelingCodes.length?'已记录今日感受':'今天感觉怎么样？'}}</text></view><view class="weight" bindtap="recordWeight"><text>{{currentWeightKg||'—'}}</text><small>kg · 记录体重</small></view></view><scroll-view scroll-x class="feelings"><view wx:for="{{wellbeingOptions}}" wx:key="code" data-code="{{item.code}}" bindtap="toggleFeeling" class="feeling {{item.selected?'active':''}}">{{item.label}}</view></scroll-view><view class="quick"><button class="quick-main" bindtap="scanFood">拍照识别食物</button><button bindtap="recordWeight">记录体重</button></view><view class="section-head"><text>今日餐单</text><text>时间可修改</text></view><view class="meal-stack"><pregnancy-meal wx:for="{{sections}}" wx:key="id" section="{{item}}" bind:add="addMeal" bind:edittime="editTime" /></view><view class="ai-note" bindtap="openAi"><text class="ai-tag">AI</text><text>{{aiTip}}</text><text class="arrow">›</text></view></view>
