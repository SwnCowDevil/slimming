.privacy-page{display:flex;flex-direction:column;gap:28rpx}.intro{padding:8rpx 4rpx 0}.intro .title{font-size:36rpx;font-weight:500}.intro .subtitle{font-size:24rpx}.privacy-list{display:flex;flex-direction:column;gap:18rpx}.copy{padding:28rpx;border-radius:28rpx}.copy-mint{background:#EEF8F2}.copy-blue{background:#F0F7FC}.copy-yellow{background:#FFF9E8}.copy-orange{background:#FFF3E7}.copy-title{font-size:28rpx;font-weight:500}.copy text,.rights text{display:block;margin-top:10rpx;color:var(--color-muted);font-size:24rpx;line-height:1.75}.rights{padding:26rpx 28rpx;background:#fff;border-radius:28rpx}.rights-title{font-size:28rpx;font-weight:500}.notice{padding:0 8rpx;color:var(--color-caption);font-size:22rpx;line-height:1.7}
