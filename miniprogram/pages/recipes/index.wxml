<view class="page recipes">
  <view class="top"><view><view class="title">健康食谱</view><view class="subtitle">按孕期偏好与食材信息筛选</view></view><button class="search" bindtap="toggleSearch">{{searching?'取消':'搜索'}}</button></view>
  <view wx:if="{{searching}}" class="search-panel"><input focus value="{{query}}" bindinput="inputSearch" confirm-type="search" placeholder="搜索菜名或食材，如鸡胸、蘑菇"/><button wx:if="{{query}}" bindtap="clearSearch">清除</button></view>
  <view class="ai-entry" bindtap="openAi"><view><text>告诉我今天想吃什么</text><small>按餐次、时间和现有食材生成建议</small></view><button>帮我推荐</button></view>
  <scroll-view scroll-x class="filters"><view wx:for="{{filters}}" wx:key="key" data-key="{{item.key}}" bindtap="choose" class="pill {{active===item.key?'active':''}}">{{item.label}}</view></scroll-view>
  <view class="section-head">{{query?'搜索结果':(active==='all'?'智能推荐':'筛选结果')}}</view>
  <view wx:if="{{visible.length}}" class="stack"><recipe-card wx:for="{{visible}}" wx:key="id" recipe="{{item}}" bind:open="open" /></view>
  <view wx:else class="empty-search"><text>没找到匹配的食谱</text><small>试试更通用的菜名或食材名称</small></view>
</view>
