<view class="page recipes"><view class="top"><view><view class="title">健康食谱</view><view class="subtitle">按孕期偏好与食材信息筛选</view></view><button class="search" bindtap="search">搜索</button></view><scroll-view scroll-x class="filters"><view wx:for="{{filters}}" wx:key="key" data-key="{{item.key}}" bindtap="choose" class="pill {{active===item.key?'active':''}}">{{item.label}}</view></scroll-view><view class="section-head">{{active==='all'?'智能推荐':'筛选结果'}}</view><view class="stack"><recipe-card wx:for="{{visible}}" wx:key="id" recipe="{{item}}" bind:open="open" /></view></view>
