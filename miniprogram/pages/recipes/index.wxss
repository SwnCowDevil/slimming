.recipes{display:flex;flex-direction:column;gap:26rpx}.top{display:flex;justify-content:space-between;align-items:center}.top .title{margin:0}.search{margin:0;width:112rpx;height:68rpx;border-radius:999rpx;background:#fff;color:var(--color-muted);font-size:23rpx}.search::after{border-color:var(--color-border)}.search-panel{display:flex;align-items:center;height:76rpx;padding:0 10rpx 0 26rpx;border:1rpx solid var(--color-border);border-radius:999rpx;background:#fff}.search-panel input{flex:1;height:100%;font-size:23rpx}.search-panel button{height:54rpx;margin:0;padding:0 20rpx;border-radius:999rpx;background:#FFF4E4;color:#B77A43;font-size:20rpx}.search-panel button::after{border:0}.ai-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 24rpx;border-radius:26rpx;background:#EEF7FC}.ai-entry>view{display:flex;flex:1;min-width:0;flex-direction:column}.ai-entry text{font-size:26rpx}.ai-entry small{margin-top:6rpx;color:#82929C;font-size:20rpx}.ai-entry button{flex-shrink:0;width:auto;min-width:142rpx;height:62rpx;margin:0;padding:0 24rpx;border:0;border-radius:20rpx;background:#FFF0D9;color:#A87542;font-size:22rpx;white-space:nowrap}.ai-entry button::after{border:0}.filters{white-space:nowrap}.pill{display:inline-block;margin-right:14rpx;padding:16rpx 26rpx;border-radius:999rpx;background:#fff;border:1rpx solid var(--color-border);color:var(--color-muted);font-size:24rpx}.pill.active{background:var(--color-primary-soft);border-color:#CDE3D5;color:#6B9B84}.section-head{font-size:31rpx;font-weight:500}.empty-search{display:flex;flex-direction:column;align-items:center;padding:72rpx 24rpx;border-radius:30rpx;background:#fff;text-align:center}.empty-search text{font-size:26rpx}.empty-search small{margin-top:10rpx;color:var(--color-caption);font-size:21rpx}
