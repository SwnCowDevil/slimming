.recipes{display:flex;flex-direction:column;gap:28rpx}.top{display:flex;justify-content:space-between;align-items:center}.top .title{margin:0}.search{margin:0;width:112rpx;height:68rpx;border-radius:999rpx;background:#fff;color:var(--color-muted);font-size:23rpx}.search::after{border-color:var(--color-border)}.filters{white-space:nowrap}.pill{display:inline-block;margin-right:14rpx;padding:16rpx 26rpx;border-radius:999rpx;background:#fff;border:1rpx solid var(--color-border);color:var(--color-muted);font-size:24rpx}.pill.active{background:var(--color-primary-soft);border-color:#CDE3D5;color:#6B9B84}.section-head{font-size:31rpx;font-weight:500}
