.profile{display:flex;flex-direction:column;gap:28rpx}.user{display:flex;justify-content:space-between;align-items:center;padding:32rpx}.name{font-size:34rpx;font-weight:500}.id{color:var(--color-caption);font-size:20rpx;margin-top:8rpx}.wechat{margin:0;background:var(--color-primary-soft);color:#6B9B84;font-size:22rpx;border-radius:999rpx}.wechat::after{border:0}.metrics{display:grid;grid-template-columns:repeat(3,1fr);padding:30rpx 10rpx;text-align:center}.metrics view{display:flex;flex-direction:column}.metrics view+view{border-left:1rpx solid var(--color-border)}.metrics text{font-family:"DIN Alternate";font-size:34rpx}.metrics small{color:var(--color-caption);font-size:21rpx;margin-top:8rpx}.section{font-size:30rpx;font-weight:500}.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.tools navigator{padding:28rpx 10rpx;background:#fff;border:1rpx solid var(--color-border);border-radius:28rpx;text-align:center;font-size:23rpx}.menu{overflow:hidden}.menu navigator{padding:30rpx;border-bottom:1rpx solid var(--color-border)}.menu navigator:last-child{border-bottom:0}.weight{padding:30rpx}.weight-row{display:flex;margin-top:22rpx}.weight-row input{flex:1;background:#F6F8F5;border-radius:22rpx;padding:0 24rpx}.weight-row button{margin-left:14rpx;background:#FFF4E3;color:#C77B2F;font-size:23rpx}.weight-row button::after{border:0}
