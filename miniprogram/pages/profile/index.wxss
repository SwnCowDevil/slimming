.profile{display:flex;flex-direction:column;gap:24rpx}.user{display:flex;justify-content:space-between;align-items:center;padding:30rpx}.name{font-size:32rpx;font-weight:500}.id{color:var(--color-caption);font-size:20rpx;margin-top:8rpx}.wechat{margin:0;background:var(--color-primary-soft);color:#5F7E6F;font-size:22rpx;border-radius:999rpx}.wechat::after{border:0}.metrics{display:grid;grid-template-columns:repeat(3,1fr);padding:28rpx 8rpx;text-align:center}.metrics view{display:flex;flex-direction:column;padding:0 8rpx}.metrics text{font-family:"DIN Alternate";font-size:32rpx}.metrics .date-value{font-size:23rpx;line-height:43rpx}.metrics small{color:var(--color-caption);font-size:20rpx;margin-top:8rpx}.section{font-size:28rpx;font-weight:500}.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.tools navigator{padding:26rpx 8rpx;background:#F0F7FC;border-radius:24rpx;text-align:center;font-size:23rpx}.menu{overflow:hidden}.menu navigator{padding:28rpx 30rpx}.menu navigator+navigator{border-top:1rpx solid var(--color-border)}.weight{padding:28rpx}.weight-row{display:flex;margin-top:20rpx}.weight-row input{flex:1;background:#F8FAF8;border-radius:22rpx;padding:0 24rpx}.weight-row button{margin-left:14rpx;background:#FFF3E7;color:#AD6F36;font-size:23rpx}.weight-row button::after{border:0}
