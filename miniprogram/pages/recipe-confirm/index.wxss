.confirm-page{display:flex;flex-direction:column;gap:24rpx}.confirm-page .title{font-size:38rpx}.meal-block,.ingredients{padding:24rpx;border-radius:28rpx;background:#fff}.label{margin-bottom:14rpx;color:#66766D;font-size:23rpx}.chips{display:flex;gap:12rpx}.chip{flex:1;padding:13rpx 8rpx;border-radius:18rpx;background:#F5F7F5;color:#859089;font-size:22rpx;text-align:center}.chip.active{background:#E8F3FA;color:#6B8798}.ingredient-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 0}.ingredient-row+.ingredient-row{border-top:1rpx solid #EDF0EE}.ingredient-copy{display:flex;flex:1;flex-direction:column}.ingredient-copy text{font-size:25rpx}.ingredient-copy small{margin-top:6rpx;color:#9AA49E;font-size:19rpx}.grams{display:flex;align-items:center;gap:8rpx;color:#78857D;font-size:22rpx}.grams input{width:110rpx;height:62rpx;border-radius:18rpx;background:#F5F7F5;text-align:center;font-size:24rpx}.estimate-note{padding:22rpx 24rpx;border-radius:24rpx;background:#FFF5E6;color:#8E775A;font-size:21rpx;line-height:1.6}.estimate-note text{display:block;margin-bottom:5rpx;color:#A06F3E}.submit{height:82rpx;margin:4rpx 0 0;border:0;border-radius:24rpx;background:#E8F3FA;color:#638297;font-size:25rpx}.submit::after{border:0}
