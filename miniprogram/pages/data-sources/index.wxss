.source-page{display:flex;flex-direction:column;gap:18rpx}.source-page>.title{font-size:36rpx;font-weight:500;margin-bottom:10rpx}.source{padding:28rpx;border-radius:28rpx}.source-mint{background:#EEF8F2}.source-blue{background:#F0F7FC}.source-yellow{background:#FFF9E8}.source view{font-size:28rpx;font-weight:500}.source text{display:block;margin-top:12rpx;color:var(--color-muted);font-size:24rpx;line-height:1.75}.source-note{margin-top:10rpx;padding:0 8rpx;color:var(--color-caption);font-size:22rpx;line-height:1.7}
