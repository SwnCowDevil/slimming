.coach{display:flex;flex-direction:column;gap:28rpx}.intro{padding:34rpx;background:#FFF9EE;border-color:#F5E4C7}.small{font-size:34rpx}.chips{display:flex;flex-wrap:wrap;gap:14rpx}.chips view{padding:18rpx 24rpx;background:#fff;border:1rpx solid var(--color-border);border-radius:999rpx;font-size:23rpx}.draft{padding:34rpx}.draft text,.draft small{display:block}.draft text{margin:16rpx 0;color:var(--color-muted);line-height:1.7}.draft small{color:var(--color-caption);font-size:20rpx}.draft button{margin-top:24rpx;background:var(--color-primary-soft);color:#6B9B84;font-size:24rpx}.draft button::after{border:0}.safety{color:var(--color-caption);font-size:21rpx;line-height:1.7}
