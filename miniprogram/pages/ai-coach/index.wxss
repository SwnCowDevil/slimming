.coach{display:flex;flex-direction:column;gap:28rpx}.intro{padding:34rpx;background:#FFF9EE;border-color:#F5E4C7}.small{font-size:34rpx}.chips{display:flex;flex-wrap:wrap;gap:14rpx}.chips button{width:auto;height:64rpx;margin:0;padding:0 24rpx;background:#fff;color:#75827B;border-radius:999rpx;font-size:23rpx;font-weight:400}.chips button::after{border:1rpx solid var(--color-border);border-radius:999rpx}.draft{padding:34rpx}.draft text,.draft small{display:block}.draft text{margin:16rpx 0;color:var(--color-muted);line-height:1.7}.draft small{color:var(--color-caption);font-size:20rpx}.draft button{height:62rpx;margin:24rpx 0 0;padding:0 24rpx;background:#EEF6FB;color:#708E9E;font-size:22rpx;font-weight:400}.draft button::after{border:0}.safety{padding:22rpx 24rpx;border-radius:22rpx;background:#F3F8F5;color:var(--color-caption);font-size:21rpx;line-height:1.7}
