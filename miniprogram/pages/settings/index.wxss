.settings-page{display:flex;flex-direction:column;gap:24rpx}.settings-page>.title{font-size:36rpx;font-weight:500}.settings-card{overflow:hidden;background:#fff;border-radius:28rpx}.setting-row{display:flex;flex-direction:column;padding:28rpx 30rpx}.setting-row+.setting-row{border-top:1rpx solid #F0F3F1}.setting-row text,.danger-zone text{font-size:27rpx}.setting-row small,.danger-zone small{margin-top:8rpx;color:var(--color-caption);font-size:22rpx;line-height:1.6}.danger-zone{display:flex;align-items:center;gap:18rpx;padding:28rpx 30rpx;background:#FFF1EE;border-radius:28rpx}.danger-zone>view{display:flex;flex:1;flex-direction:column}.danger-zone button{margin:0;padding:0 24rpx;background:#FFE4DE;color:#A85F51;font-size:22rpx;border-radius:999rpx}.danger-zone button::after{border:0}
