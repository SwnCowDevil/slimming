.record{display:flex;flex-direction:column;gap:24rpx}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.quick button{height:70rpx;margin:0;padding:0;background:#fff;border-radius:20rpx;color:#718078;font-size:22rpx}.quick button::after{border:1rpx solid #E4ECE7;border-radius:20rpx}.date-title{display:flex;align-items:center;justify-content:space-between;margin-top:4rpx}.date-title text:first-child{font-size:28rpx;font-weight:500}.date-title text:last-child{color:#9AA49F;font-size:20rpx}.meal-stack{display:flex;flex-direction:column;gap:18rpx}
