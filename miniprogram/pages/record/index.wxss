.record{display:flex;flex-direction:column;gap:24rpx}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.quick button{height:70rpx;margin:0;padding:0;background:#fff;border-radius:20rpx;color:#718078;font-size:22rpx}.quick button::after{border:1rpx solid #E4ECE7;border-radius:20rpx}.record-summary{display:flex;align-items:center;justify-content:space-between;padding:24rpx 26rpx;border-radius:26rpx;background:linear-gradient(135deg,#EFF7FB,#FFF8EB)}.summary-date,.summary-label{display:block}.summary-date{font-size:25rpx;color:#64736C}.summary-label{margin-top:6rpx;color:#98A39D;font-size:19rpx}.summary-facts{display:flex;align-items:center;gap:12rpx}.summary-facts text{padding:9rpx 14rpx;border-radius:14rpx;background:rgba(255,255,255,.72);color:#75847D;font-size:21rpx}.date-title{display:flex;align-items:center;justify-content:space-between;margin-top:4rpx}.date-title text:first-child{font-size:28rpx;font-weight:500}.date-title text:last-child{color:#9AA49F;font-size:20rpx}.timeline{display:flex;flex-direction:column;gap:18rpx}.timeline-group{padding:24rpx 26rpx;border-radius:26rpx;background:#fff;border:1rpx solid #E5ECE8}.group-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:16rpx}.group-head>view{display:flex;align-items:center;gap:16rpx}.group-time{padding:8rpx 11rpx;border-radius:12rpx;background:#EEF6FB;color:#7892A1;font-size:20rpx}.group-name{font-size:26rpx}.group-kcal{color:#C48752;font-size:21rpx}.record-row{display:flex;justify-content:space-between;align-items:center;padding:17rpx 0;border-top:1rpx solid #EFF2F0}.food-name,.food-meta{display:block}.food-name{font-size:24rpx}.food-meta{margin-top:5rpx;color:#97A29D;font-size:19rpx}.actor{color:#A1AAA6;font-size:18rpx}.group-add{height:58rpx;margin:12rpx 0 0;padding:0;border-radius:16rpx;background:#FFF7E9;color:#B47B49;font-size:21rpx}.group-add::after{border:0}.empty-record{display:flex;flex-direction:column;align-items:center;padding:58rpx 32rpx;border-radius:28rpx;background:#fff;text-align:center}.empty-record text{font-size:26rpx}.empty-record small{margin-top:10rpx;color:#9AA49F;font-size:20rpx}.empty-record button{height:64rpx;margin:26rpx 0 0;padding:0 28rpx;border-radius:19rpx;background:#EEF6FB;color:#728D9C;font-size:22rpx}.empty-record button::after{border:0}
