.record{display:flex;flex-direction:column;gap:30rpx}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.quick .button-light{width:100%;height:76rpx;font-size:23rpx}.date-title{font-size:32rpx;font-weight:500}.habit-card{display:grid;grid-template-columns:1fr 1fr;padding:30rpx}.habit-card view{display:flex;flex-direction:column;gap:8rpx}.habit-card view+view{border-left:1rpx solid var(--color-border);padding-left:30rpx}.habit-card text:last-child{color:var(--color-muted);font-size:24rpx}
