<view class="page record"><record-calendar marks="{{marks}}" bind:datechange="dateChange" bind:viewchange="viewChange" /><view class="quick"><button bindtap="search">搜索食物</button><button bindtap="recent">最近吃过</button><button bindtap="photo">拍照识别</button></view><view class="date-title"><text>{{selectedDate}} 的餐单</text><text>点击时间可修改</text></view><view class="meal-stack"><pregnancy-meal wx:for="{{sections}}" wx:key="id" section="{{item}}" bind:add="addMeal" bind:edittime="editTime" /></view></view>
