.estimate-page{display:flex;flex-direction:column;gap:24rpx}.estimate-intro{padding:8rpx 4rpx 2rpx}.estimate-intro .title{margin:0;font-size:34rpx;font-weight:500}.estimate-intro .subtitle{margin-top:8rpx;color:#84918A;font-size:22rpx;line-height:1.6}.category-scroll{width:100%;white-space:nowrap}.category-row{display:inline-flex;gap:12rpx;padding:0 4rpx 4rpx}.category{width:auto;height:60rpx;margin:0;padding:0 22rpx;border-radius:999rpx;background:#fff;color:#7E8B84;font-size:21rpx;font-weight:400}.category::after{border:1rpx solid #E3EBE5;border-radius:999rpx}.category.active{background:#EAF6EF;color:#648475}.category.active::after{border-color:#D2E8DC}.estimate-list{overflow:hidden;border-radius:28rpx;background:#fff}.estimate-row{padding:26rpx}.estimate-row+.estimate-row{border-top:1rpx solid #EDF2EE}.item-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx}.item-copy{min-width:0}.item-name,.item-reference{display:block}.item-name{color:#59645E;font-size:27rpx;font-weight:500}.item-reference{margin-top:6rpx;color:#C17C43;font-size:21rpx}.item-detail{max-width:280rpx;color:#98A39D;font-size:19rpx;line-height:1.55;text-align:right}.estimate-result{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx;padding:18rpx 20rpx;border-radius:20rpx;background:#FFF8EC}.weight-copy small,.weight-copy strong{display:block}.weight-copy small{color:#9A8E7F;font-size:18rpx}.weight-copy strong{margin-top:4rpx;color:#8E6C4C;font-size:25rpx;font-weight:500}.stepper{display:grid;grid-template-columns:54rpx 92rpx 54rpx;align-items:center;border-radius:16rpx;background:#fff}.stepper button{width:54rpx;height:52rpx;margin:0;padding:0;background:transparent;color:#789082;font-size:27rpx}.stepper button::after{border:0}.stepper text{color:#68746E;font-size:20rpx;text-align:center}.record-action{height:58rpx;margin:16rpx 0 0;padding:0;border-radius:17rpx;background:#EDF5FA;color:#6E8EA1;font-size:21rpx;font-weight:400}.record-action::after{border:0}.estimate-note{padding:22rpx 24rpx;border-radius:22rpx;background:#F1F7F3;color:#7F8E86;font-size:20rpx;line-height:1.65}
