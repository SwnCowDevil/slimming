.dietitian{padding:34rpx}.name{font-size:32rpx;font-weight:500}.credentials{color:var(--color-caption);font-size:22rpx;margin-top:8rpx}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin:20rpx 0}.tags text{background:var(--color-primary-soft);color:#6B9B84;padding:8rpx 14rpx;border-radius:999rpx;font-size:20rpx}.bio{color:var(--color-muted);font-size:24rpx;line-height:1.6}.dietitian button{margin-top:24rpx;background:#FFF4E3;color:#C77B2F;font-size:23rpx}.dietitian button::after{border:0}.empty{text-align:center;color:var(--color-caption);padding:80rpx}
