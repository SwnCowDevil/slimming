<view class="page search-page"><view class="search-box"><input value="{{query}}" bindinput="input" confirm-type="search" bindconfirm="search" placeholder="搜索食物营养和热量"/><button bindtap="search">搜索</button></view><view class="source">数据来源：Estonian TKA · 结果按 100 克展示</view><view class="results"><view wx:for="{{items}}" wx:key="source_food_id" class="food card" data-item="{{item}}" bindtap="choose"><view><text>{{item.name}}</text><small>点击选择餐别与克数</small></view><view class="energy">{{item.energy_kcal_100g}} kcal</view></view></view><view wx:if="{{!loading && searched && catalogReady===false}}" class="empty catalog-empty"><text>食品数据库尚未导入</text><small>请先在后端导入已授权的 TKA 数据集，再搜索和记录。</small></view><view wx:elif="{{!loading && searched && !items.length}}" class="empty">没有找到，试试更通用的名称。</view></view>
