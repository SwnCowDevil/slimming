.search-page{display:flex;flex-direction:column;gap:24rpx}.search-box{display:flex;gap:12rpx}.search-box input{flex:1;height:82rpx;background:#fff;border:1rpx solid var(--color-border);border-radius:999rpx;padding:0 28rpx}.search-box button{margin:0;background:#FFF4E3;color:#C77B2F;border-radius:999rpx;font-size:23rpx}.search-box button::after{border:0}.source{color:var(--color-caption);font-size:21rpx}.results{display:flex;flex-direction:column;gap:16rpx}.food{padding:26rpx;display:flex;justify-content:space-between;align-items:center}.food text,.food small{display:block}.food small{color:var(--color-caption);font-size:20rpx;margin-top:7rpx}.energy{color:#C77B2F;font-family:"DIN Alternate"}.empty{text-align:center;color:var(--color-caption);padding:80rpx 0}
