<view class="page analysis"><view class="header"><view class="title">趋势分析</view><button bindtap="openAi">AI 解读</button></view><view class="periods"><view wx:for="{{periods}}" wx:key="*this" data-period="{{item}}" bindtap="changePeriod" class="{{period===item?'active':''}}">{{item}}天</view></view><health-chart title="体重趋势" type="weight" points="{{weightPoints}}"/><health-chart title="热量达成" type="calorie" points="{{calorieDays}}"/><view class="macro card"><view class="section">营养目标平均达成</view><nutrient-bars items="{{macroBars}}" /></view><view wx:if="{{insight}}" class="insight">{{insight}}</view></view>
