.analysis{display:flex;flex-direction:column;gap:24rpx}.header{display:flex;justify-content:space-between;align-items:center}.header .title{margin:6rpx 0 0;font-size:36rpx;font-weight:500}.header button{margin:0;height:62rpx;padding:0 22rpx;background:#FFF3DF;color:#AB7444;font-size:22rpx;border-radius:999rpx}.header button::after{border:0}.periods{display:grid;grid-template-columns:repeat(3,1fr);padding:7rpx;background:#EEF5F1;border-radius:24rpx;text-align:center}.periods view{padding:15rpx;border-radius:19rpx;color:#91A098;font-size:22rpx}.periods .active{background:#fff;color:#5E7368;box-shadow:0 4rpx 14rpx rgba(90,110,100,.06)}.facts{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.facts view{padding:22rpx;background:#F5FAF7;border-radius:22rpx;color:#718078;font-size:22rpx}.insight{padding:26rpx;background:#FFF8EC;border-radius:26rpx;color:#777D79;font-size:23rpx;line-height:1.65}.insight text{display:block}.insight .label{margin-bottom:8rpx;color:#A77345;font-weight:500}.disclaimer{padding:0 14rpx;color:#A2AAA6;font-size:20rpx;line-height:1.6}
