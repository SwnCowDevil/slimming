.analysis{display:flex;flex-direction:column;gap:28rpx}.header{display:flex;justify-content:space-between;align-items:center}.header .title{margin:0}.header button{margin:0;background:#FFF9EE;color:#C77B2F;font-size:22rpx;border-radius:999rpx}.header button::after{border:0}.periods{display:grid;grid-template-columns:repeat(3,1fr);padding:8rpx;background:#EDF2EE;border-radius:28rpx;text-align:center}.periods view{padding:17rpx;border-radius:22rpx;color:var(--color-caption);font-size:23rpx}.periods .active{background:#fff;color:var(--color-text)}.macro{padding:30rpx}.section{font-size:29rpx;font-weight:500}.insight{padding:28rpx;background:#FFF9EE;border:1rpx solid #F5E4C7;border-radius:32rpx;color:var(--color-muted);font-size:24rpx}
