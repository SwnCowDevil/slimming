.budget-card{background:#EAF4ED;border-radius:44rpx;padding:28rpx}.inner{background:#fff;border:1rpx solid #E3EBE5;border-radius:36rpx;padding:30rpx}.head,.meta{display:flex;justify-content:space-between;color:#6F787E;font-size:24rpx}.status{background:#F2F8F4;color:#6B9B84;border-radius:999rpx;padding:6rpx 16rpx;font-size:20rpx}.remaining{text-align:center;margin:22rpx 0}.caption{display:block;color:#8B9A90;font-size:22rpx}.number{font-family:"DIN Alternate";font-size:66rpx;font-weight:600;color:#47515A}.unit{color:#8B9A90;font-size:23rpx}.meta view{display:flex;flex-direction:column;gap:4rpx}.meta strong{font-size:26rpx;font-weight:500;color:#47515A}.right{text-align:right}.track{height:12rpx;background:#E9EEEA;border-radius:999rpx;margin-top:18rpx;overflow:hidden}.fill{height:100%;background:#F2A65A;border-radius:999rpx}
