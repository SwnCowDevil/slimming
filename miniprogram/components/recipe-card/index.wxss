.recipe{overflow:hidden;background:#fff;border:1rpx solid #E8ECE9;border-radius:32rpx}.photo{display:block;width:100%;height:360rpx;background:#F6F8F5}.content{padding:24rpx 26rpx}.badges{display:flex;gap:10rpx;margin-bottom:14rpx}.badges text{padding:7rpx 12rpx;border-radius:999rpx;background:#F0F7FC;color:#718A9C;font-size:19rpx}.badges text+text{background:#FFF4E5;color:#A77946}.row{display:flex;justify-content:space-between;gap:20rpx}.name{font-size:29rpx;font-weight:500}.kcal{color:#C77B2F;font-family:"DIN Alternate";font-size:23rpx}.meta{margin-top:10rpx;color:#8B9A90;font-size:22rpx}.save{height:66rpx;margin:22rpx 0 0;border:0;border-radius:22rpx;background:#EAF5EF;color:#628875;font-size:23rpx}.save::after{border:0}.save.saved{background:#F4F6F4;color:#96A29B}
