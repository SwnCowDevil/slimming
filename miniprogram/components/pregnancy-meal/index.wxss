.meal-shell{padding:26rpx 28rpx;background:#fff;border:1rpx solid #E5ECE8;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(95,120,106,.05)}.meal-head{display:flex;align-items:center;justify-content:space-between}.meal-name{font-size:29rpx;font-weight:500;color:#4F5D56}.meal-time{margin-left:18rpx;padding:8rpx 12rpx;border-radius:14rpx;background:#F2F8F4;color:#789187;font-size:21rpx}.meal-total{color:#C48752;font-size:23rpx}.food-list{margin-top:18rpx}.food-row{display:flex;justify-content:space-between;align-items:center;padding:16rpx 0;border-top:1rpx solid #EDF1EF}.food-name,.food-meta{display:block}.food-name{font-size:25rpx}.food-meta{margin-top:5rpx;color:#97A29D;font-size:20rpx}.actor{color:#A1AAA6;font-size:19rpx}.add{height:66rpx;margin-top:16rpx;background:#FAFCFA;border-radius:18rpx;color:#899B92;font-size:23rpx}.add::after{border:1rpx dashed #DDE8E1;border-radius:18rpx}
