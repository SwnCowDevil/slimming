<view class="meal-shell"><view class="meal-head"><view><text class="meal-name">{{section.title}}</text><text class="meal-time" bindtap="editTime">{{section.time}}　修改</text></view><text class="meal-total" wx:if="{{section.items.length}}">{{section.kcal}} kcal</text></view><view class="food-list" wx:if="{{section.items.length}}"><view class="food-row" wx:for="{{section.items}}" wx:key="id"><view><text class="food-name">{{item.food_name}}</text><text class="food-meta">{{item.grams}} 克 · {{item.energy_kcal}} kcal</text></view><text class="actor">{{item.created_by_user_id===item.subject_user_id?'本人':'家人'}}</text></view></view><button class="add" bindtap="add">＋ 添加食物</button></view>
