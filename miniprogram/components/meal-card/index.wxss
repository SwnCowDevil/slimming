.meal{padding:28rpx 30rpx}.meal-head{display:flex;justify-content:space-between;align-items:center}.dot{display:inline-block;width:12rpx;height:12rpx;border-radius:50%;background:#78A992;margin-right:14rpx}.name{font-size:30rpx;font-weight:500}.time{margin-left:14rpx;color:#8B9A90;font-size:21rpx}.kcal{font-family:"DIN Alternate";font-size:26rpx}.food{padding:20rpx 0 0 26rpx}.food-name,.grams{display:block}.food-name{font-size:26rpx}.grams{color:#8B9A90;font-size:21rpx;margin-top:5rpx}.add{margin-top:22rpx;background:#fff;border:1rpx dashed #D9E4DC;color:#8B9A90;font-size:24rpx}.add::after{border:0}
