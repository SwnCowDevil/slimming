<view class="meal card"><view class="meal-head"><view><text class="dot"></text><text class="name">{{title}}</text><text class="time">{{time}}</text></view><text class="kcal">{{kcal}} kcal</text></view><view wx:if="{{items.length}}"><view class="food" wx:for="{{items}}" wx:key="id"><view><text class="food-name">{{item.food_name}}</text><text class="grams">{{item.grams}}克 · {{item.energy_kcal}} kcal{{item.nutrition_source==='ai_estimated'?' · AI 估算':''}}</text></view></view></view><button wx:else class="add" bindtap="add">添加食物</button></view>
